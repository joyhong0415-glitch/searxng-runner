<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            style="@style/SmallLabel"
            android:layout_marginTop="0dp"
            android:text="@string/label_status" />

        <TextView
            android:id="@+id/statusText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/status_unknown"
            android:textColor="@color/text_dim"
            android:textSize="28sp"
            android:textStyle="bold" />

        <TextView
            style="@style/SmallLabel"
            android:text="@string/label_address" />

        <TextView
            android:id="@+id/addressText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="http://0.0.0.0:8080"
            android:textColor="@color/primary"
            android:textIsSelectable="true"
            android:textSize="30sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnCopyAddress"
            style="@style/BigButton"
            android:text="@string/btn_copy" />

        <Button
            android:id="@+id/btnInstall"
            style="@style/BigButton"
            android:text="@string/btn_install" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnStart"
                style="@style/BigButton"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:text="@string/btn_start" />

            <Button
                android:id="@+id/btnStop"
                style="@style/BigButton"
                android:layout_width="0dp"
                android:layout_marginLeft="10dp"
                android:layout_weight="1"
                android:text="@string/btn_stop" />
        </LinearLayout>

        <Button
            android:id="@+id/btnRestart"
            style="@style/BigButton"
            android:text="@string/btn_restart" />

        <Button
            android:id="@+id/btnTest"
            style="@style/BigButton"
            android:text="@string/btn_test" />

        <Button
            android:id="@+id/btnBattery"
            style="@style/BigButton"
            android:text="@string/btn_battery" />

        <Button
            android:id="@+id/btnGuide"
            style="@style/BigButton"
            android:text="@string/btn_guide" />

        <TextView
            style="@style/SmallLabel"
            android:text="@string/label_log" />

        <TextView
            android:id="@+id/logText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#FFF2F2F2"
            android:fontFamily="monospace"
            android:minHeight="180dp"
            android:padding="10dp"
            android:textColor="@color/text"
            android:textIsSelectable="true"
            android:textSize="12sp" />

    </LinearLayout>
</ScrollView>
